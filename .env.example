# proxy-guard 环境配置示例
# 复制为 .env 并填写：cp .env.example .env && chmod 600 .env

# Telegram 告警（可选，不填则静默跳过告警）
# 获取 bot token: 找 @BotFather 发送 /newbot
# 获取 chat id:   给 @userinfobot 发任意消息，回复中的 id 即是
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# mihomo 出口组名（必须与 config.yaml 中的组名一致）
GUARD_GROUP=交易专用

# sudo 密码（guard 重启 mihomo 时需要；留空则需配置 NOPASSWD sudo）
# 配置 NOPASSWD 示例:  sudo visudo 添加  <user> ALL=(ALL) NOPASSWD: /usr/bin/systemctl
SUDO_PASSWORD=

# 高级配置（一般不需要改）
# MIHOMO_API=http://127.0.0.1:9090
# PROXY=http://127.0.0.1:7890
# MAX_SWITCH=15
